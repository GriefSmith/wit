# Copy to `.env` and adjust (`.env` is gitignored).
#
# Directory containing wit page *.md files — not a single file path.
# Omit WIT_PAGES_ROOT to use the default: wit/data/pages/ (anchored to the repo,
# whatever directory the server starts from). A relative value here is resolved
# from the server process's working directory, so prefer an absolute path.
#
# WIT_PAGES_ROOT=/path/to/your/pages

# Setting WIT_CORS_ORIGINS replaces the built-in default, which is the four
# origins below. Keep any you still use when adding a new one.
# WIT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
